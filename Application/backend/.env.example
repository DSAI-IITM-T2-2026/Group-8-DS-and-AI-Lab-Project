# Never commit credentials. The pipeline also loads Application/daily_pipeline/.env.
PIPELINE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WILDFIRE_MODEL_URI=gs://wildfire-detection-first/champion_training_outputs/champion_training_outputs_stage_c_knn_high_medium_fire/models/champion_model.joblib
WILDFIRE_ALLOW_GCS=true
# Optional, only for GET /api/v1/validation/events:
# WILDFIRE_HISTORICAL_ARCHIVE=/secure/local/path/2019-2025.parquet
# Leave unset to use Application/.venv/bin/python automatically.
# PIPELINE_PYTHON=/absolute/path/to/Application/.venv/bin/python
# Optional overrides:
# PIPELINE_ROOT=/absolute/path/to/Application/daily_pipeline
# PIPELINE_STATE_DIR=/persistent/path/to/pipeline-api
