# Copy to .env in this folder (Application/daily_pipeline/.env) and fill in values.
# Loaded automatically by utils/bootstrap.py when present.
# Never commit .env (it is gitignored).

# --- Copernicus CDS (ERA5) ---
# Format: UID:API_KEY  (from https://cds.climate.copernicus.eu/)
CDS_API_KEY=
# Optional override (default: https://cds.climate.copernicus.eu/api)
# CDS_API_URL=https://cds.climate.copernicus.eu/api

# --- Google Cloud ---
# Used by google-cloud-storage / Earth Engine client defaults
GOOGLE_CLOUD_PROJECT=plated-mechanic-418917
# Path to a service-account JSON (VM / Cloud Run). Leave empty to use ADC / gcloud auth.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# Local setup only. Never enable this for the API worker, cron, or deployment.
# WILDFIRE_ALLOW_INTERACTIVE_EE_AUTH=false

# --- Optional download overrides (normally set in utils/config.yaml) ---
# GCS_BUCKET=wildfire-detection-first
# GCS_PREFIX=era5
# DATE=2026-08-10

# --- FIRMS / Stage A GCS reads ---
# Set automatically by bootstrap if missing; keep YES for anonymous /vsigs FIRMS reads.
GS_NO_SIGN_REQUEST=YES
