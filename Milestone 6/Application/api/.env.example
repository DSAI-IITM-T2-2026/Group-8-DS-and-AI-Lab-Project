# The unified backend loads Application/backend/.env. This file documents
# inference-only variables for standalone API development. Never commit .env.

# Real trained model artifact (wildfire_model.joblib) from
# Milestone 5/Wildfire_Training_final.ipynb. Not checked into this repo.
# Without this, /risk-map, /predictions, and /validation/events answer 503.
WILDFIRE_MODEL_URI=gs://wildfire-detection-first/champion_training_outputs/champion_training_outputs_stage_c_knn_high_medium_fire/models/champion_model.joblib

# Optional local copy of final_processed/2019_2025/2019-2025.parquet
# (see daily_pipeline/README.md "Zero-download 2025 replay"). Only used by
# GET /validation/events.
WILDFIRE_HISTORICAL_ARCHIVE=

# Whether the API may stream final_processed/*.parquet from GCS. Requires ADC / GOOGLE_APPLICATION_CREDENTIALS
# with access to the bucket configured in daily_pipeline/utils/config.yaml.
WILDFIRE_ALLOW_GCS=true

# Comma-separated list of allowed frontend origins for CORS. "*" for local dev.
WILDFIRE_FRONTEND_ORIGINS=*

# Reused by daily_pipeline/utils/bootstrap.py -- see daily_pipeline/.env.example.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
